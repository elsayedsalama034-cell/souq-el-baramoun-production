rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /ads/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == uid || admin())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == uid || admin())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }
    match /payment-receipts/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && (request.auth.uid == uid || admin());
    }
  }
}
