rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function admin() { return signedIn() && me().data.role == 'admin' && me().data.active == true; }

    match /ads/{adId} {
      allow read: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid) || (resource.data.status == 'approved' && resource.data.subscriptionActive == true && resource.data.subscriptionExpiresAt > request.time);
      allow create: if admin() || (signedIn() && request.resource.data.ownerId == request.auth.uid
        && me().data.role == 'advertiser' && me().data.active == true
        && me().data.subscriptionStatus == 'active'
        && me().data.subscriptionExpiresAt > request.time
        && request.resource.data.status == 'pending');
      allow update: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == 'pending'
        && request.resource.data.featured == resource.data.featured
        && request.resource.data.subscriptionActive == resource.data.subscriptionActive
        && request.resource.data.subscriptionExpiresAt == resource.data.subscriptionExpiresAt);
      allow delete: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId) || (resource.data.role == 'advertiser' && resource.data.active == true);
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['visitor','advertiser']
        && request.resource.data.active == true;
      allow update: if admin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.subscriptionPlan == resource.data.subscriptionPlan
        && request.resource.data.subscriptionStartedAt == resource.data.subscriptionStartedAt
        && request.resource.data.subscriptionExpiresAt == resource.data.subscriptionExpiresAt);
      allow delete: if admin();
    }

    match /users/{sellerId}/followers/{viewerId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == viewerId && viewerId != sellerId;
      allow delete: if signedIn() && request.auth.uid == viewerId;
      allow update: if false;
    }

    match /users/{sellerId}/ratings/{viewerId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == viewerId && viewerId != sellerId
        && request.resource.data.userId == viewerId
        && request.resource.data.value is int
        && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      allow delete: if signedIn() && request.auth.uid == viewerId;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if admin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && me().data.role == 'advertiser' && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'vodafone_cash';
      allow update, delete: if admin();
    }


    match /notifications/{notificationId} {
      allow read: if admin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all'));
      allow create: if admin();
      allow update: if admin() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if admin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
